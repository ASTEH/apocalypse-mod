{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftermath.example/schemas/zombie-variant.schema.json",
  "title": "Aftermath Zombie Variant",
  "description": "Runtime definition loaded from data/<namespace>/zombie_variants/<name>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_entity_tag", "weight", "spawn", "attributes"],
  "properties": {
    "target_entity_tag": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
    "weight": {"type": "integer", "minimum": 1, "maximum": 10000},
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time_of_day": {"type": "string", "enum": ["any", "day", "night"], "default": "any"},
        "dimensions": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"}, "uniqueItems": true},
        "biomes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"}, "uniqueItems": true},
        "spawn_types": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+$"}, "default": ["natural", "chunk_generation"]},
        "min_light": {"type": "integer", "minimum": 0, "maximum": 15},
        "max_light": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_health", "movement_speed", "attack_damage"],
      "properties": {
        "max_health": {"$ref": "#/$defs/numericRange"},
        "movement_speed": {"$ref": "#/$defs/numericRange"},
        "attack_damage": {"$ref": "#/$defs/numericRange"},
        "follow_range": {"$ref": "#/$defs/numericRange"},
        "knockback_resistance": {"$ref": "#/$defs/numericRange"}
      }
    },
    "senses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vision_range": {"$ref": "#/$defs/numericRange"},
        "hearing_range": {"$ref": "#/$defs/numericRange"}
      }
    }
  },
  "$defs": {
    "numericRange": {
      "oneOf": [
        {"type": "number"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {"min": {"type": "number"}, "max": {"type": "number"}}
        }
      ]
    }
  }
}
